{
  "manifest_version": 3,
  "name": "VaultNova — Password Manager",
  "version": "1.1.0",
  "description": "Secure AES-256 encrypted password manager with multi-cloud sync",
  "permissions": ["storage", "identity", "clipboardWrite", "clipboardRead", "tabs"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VaultNova"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["tab.html"],
    "matches": ["<all_urls>"]
  }]
}
